-- ========== TWEENING ==========
local currentTween = nil
local function forceTweenTo(destinationCFrame, durationOverride)
    if not FARM_ENABLED and not CANDY_ENABLED and not INVISIBLE_ENABLED then return end
    if destinationCFrame.Position.Y < MIN_SAFE_Y then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not rootPart or not humanoid then return end
    local duration = durationOverride
    if not duration then
        local distance = (rootPart.Position - destinationCFrame.Position).Magnitude
        duration = math.max(0.05, distance / TWEEN_SPEED)
    end
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destinationCFrame})
    pcall(function() humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    local forceConnection
    forceConnection = RunService.Heartbeat:Connect(function()
        if not FARM_ENABLED and not CANDY_ENABLED and not INVISIBLE_ENABLED then
            if forceConnection then forceConnection:Disconnect() end
            return
        end
        if character and rootPart and humanoid then
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    currentTween:Play()
    currentTween.Completed:Wait()
    if forceConnection then forceConnection:Disconnect() end
end

-- ========== INSTANT TELEPORT ==========
local function instantTeleportTo(destinationCFrame)
    if destinationCFrame.Position.Y < MIN_SAFE_Y then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not rootPart or not humanoid then return end
    pcall(function() character:PivotTo(destinationCFrame) end)
    rootPart.CFrame = destinationCFrame
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    pcall(function() humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
end

-- ========== DOOR TARGET FINDERS ==========
local function getAllDoorTargets()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return {} end
    local list = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local parentObj = v.Parent
            local isHalloween = v.ObjectText:lower():match("trick") or v.ActionText:lower():match("treat") or parentObj.Name:lower():match("halloween")
            if isHalloween then
                local interactablePart = parentObj:IsA("BasePart") and parentObj or parentObj:FindFirstChildWhichIsA("BasePart")
                if interactablePart and interactablePart.Position.Y > MIN_SAFE_Y then
                    table.insert(list, {
                        part = interactablePart, prompt = v, model = parentObj,
                        dist = (rootPart.Position - interactablePart.Position).Magnitude,
                    })
                end
            end
        end
    end
    return list
end

local function findDoorTarget()
    local list = getAllDoorTargets()
    local chosen = nil
    for _, d in ipairs(list) do
        if not chosen or d.dist < chosen.dist then chosen = d end
    end
    if chosen then return chosen.part, chosen.prompt, chosen.model end
    return nil, nil, nil
end

-- ========== CANDY TARGET ==========
local function findCandyTarget()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil, nil, 0 end
    local chosenPart, chosenPrompt, closestDistance, totalCandyFound = nil, nil, math.huge, 0
    local function scanContainer(container)
        if not container or not container:IsDescendantOf(workspace) then return end
        for _, v in ipairs(container:GetDescendants()) do
            if v:IsDescendantOf(workspace) then
                local isPrompt = v:IsA("ProximityPrompt")
                local interactablePart = v:IsA("BasePart") and v or (isPrompt and v.Parent:FindFirstChildWhichIsA("BasePart"))
                local clickDetector = v:IsA("ClickDetector")
                if interactablePart then
                    totalCandyFound = totalCandyFound + 1
                    local dist = (rootPart.Position - interactablePart.Position).Magnitude
                    if dist < closestDistance and interactablePart.Position.Y > MIN_SAFE_Y then
                        closestDistance = dist; chosenPart = interactablePart
                        if isPrompt then chosenPrompt = v end
                    end
                elseif clickDetector and clickDetector.Parent:IsA("BasePart") then
                    totalCandyFound = totalCandyFound + 1
                    local dist = (rootPart.Position - clickDetector.Parent.Position).Magnitude
                    if dist < closestDistance and clickDetector.Parent.Position.Y > MIN_SAFE_Y then
                        closestDistance = dist; chosenPart = clickDetector.Parent; chosenPrompt = clickDetector
                    end
                end
            end
        end
    end
    scanContainer(workspace:FindFirstChild("CandyVisuals"))
    scanContainer(workspace:FindFirstChild("HalloweenCandy"))
    scanContainer(workspace:FindFirstChild("CandyRainFX"))
    return chosenPart, chosenPrompt, totalCandyFound
end

-- ========== CANDY COLLECT (0.1s TOUCH) ==========
local function collectAllCandy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local originalPos = root.CFrame
    local foundAnyCandy = false
    while CANDY_ENABLED do
        if isDead then break end
        local currentTarget, currentPrompt, candyCount = findCandyTarget()
        if candyCount == 0 or not currentTarget then break end
        foundAnyCandy = true
        clearAllChams()
        applyChams(currentTarget, 1, CANDY_CHAMS_COLOR)
        local candyTouchCFrame = CFrame.new(currentTarget.Position + Vector3.new(0, 2, 0))
        if _G.setStatus then _G.setStatus("Candy Grab (" .. candyCount .. ")", CANDY_CHAMS_COLOR) end
        instantTeleportTo(candyTouchCFrame)
        if currentPrompt then
            pcall(function()
                if currentPrompt:IsA("ProximityPrompt") then
                    if fireproximityprompt then fireproximityprompt(currentPrompt)
                    else currentPrompt:InputHoldBegin(); task.wait(0.01); currentPrompt:InputHoldEnd() end
                elseif currentPrompt:IsA("ClickDetector") then
                    if fireclickdetector then fireclickdetector(currentPrompt) end
                end
            end)
        end
        pcall(function()
            firetouchinterest(root, currentTarget, 0)
            task.wait(0.01)
            firetouchinterest(root, currentTarget, 1)
        end)
        task.wait(0.1)
    end
    if foundAnyCandy and root then
        root.CFrame = originalPos
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if _G.setStatus then _G.setStatus("Returned to Door", THEME.SUCCESS) end
    end
    return foundAnyCandy
end

-- ========== PINATA FINDER ==========
local function findPinata()
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local penyta = live:FindFirstChild("Penyta")
    if not penyta then return nil end
    local hrp = penyta:FindFirstChild("HumanoidRootPart") or penyta:FindFirstChildWhichIsA("BasePart")
    return penyta, hrp
end

-- ========== PC SPOOF & SKILLS ==========
local function spoofPC()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end)
end

local skillThread = nil
local function startSkillSpam()
    if skillThread then return end
    skillThread = task.spawn(function()
        spoofPC()
        task.wait(0.1)
        while PINATA_ENABLED do
            if isDead then task.wait(0.2); continue end
            for i = 1, 4 do
                if not PINATA_ENABLED then break end
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[i], false, game)
                    task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[i], false, game)
                end)
                task.wait(0.03)
            end
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            end)
            task.wait(0.05)
        end
        skillThread = nil
    end)
end
local function stopSkillSpam()
    if skillThread then task.cancel(skillThread); skillThread = nil end
end

-- ========== KNOCK ATTEMPT ==========
local function tryKnock(prompt)
    if not prompt then return false end
    local ok, success = pcall(function()
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
                return true
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.3)
                prompt:InputHoldEnd()
                return true
            end
        end
        return false
    end)
    return ok and success or false
end

-- ========== MAIN FARM LOOP ==========
local farmThread = nil
local function startFarm()
    if farmThread then task.cancel(farmThread) end
    setNoclip(true)
    farmThread = task.spawn(function()
        if _G.setStatus then _G.setStatus("Farming...", THEME.SUCCESS) end
        while FARM_ENABLED or CANDY_ENABLED or PINATA_ENABLED or INVISIBLE_ENABLED do
            task.wait(0.05)
            if isDead then task.wait(1); continue end

            if PINATA_ENABLED then
                local penyta, hrp = findPinata()
                if penyta and hrp then
                    if FARM_ENABLED then FARM_ENABLED = false; toggleBtn.Text = "◉  AUTO FARM: OFF"; setButtonState(toggleBtn, false) end
                    if CANDY_ENABLED then CANDY_ENABLED = false; candyBtn.Text = "◉  AUTO CANDY: OFF"; setButtonState(candyBtn, false) end
                    if INVISIBLE_ENABLED then INVISIBLE_ENABLED = false; invisibleBtn.Text = "◉  INVISIBLE: OFF"; setButtonState(invisibleBtn, false) end
                    clearAllChams()
                    applyChams(penyta, 1, PINATA_CHAMS_COLOR)
                    if _G.setStatus then _G.setStatus("Piñata! Attacking...", THEME.PINATA) end

                    local belowCF = hrp.CFrame * CFrame.new(0, -PINATA_BELOW_DISTANCE, 0)
                    instantTeleportTo(belowCF)
                    startSkillSpam()

                    while PINATA_ENABLED and not isDead do
                        local p, h = findPinata()
                        if not p or not h or not p:IsDescendantOf(workspace) then break end
                        local char = LocalPlayer.Character
                        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            local target = h.Position - Vector3.new(0, PINATA_BELOW_DISTANCE, 0)
                            myHrp.CFrame = CFrame.new(target, target + h.CFrame.LookVector)
                            myHrp.AssemblyLinearVelocity = Vector3.zero
                            myHrp.AssemblyAngularVelocity = Vector3.zero
                        end
                        local hp = "?"
                        pcall(function()
                            local hum = p:FindFirstChildOfClass("Humanoid")
                            if hum then hp = math.floor(hum.Health) end
                        end)
                        if _G.setStatus then _G.setStatus("Piñata HP: " .. tostring(hp), THEME.PINATA) end
                        task.wait(0.1)
                    end

                    stopSkillSpam()
                    clearAllChams()
                    if PINATA_ENABLED then
                        if _G.setStatus then _G.setStatus("Piñata gone! Restoring...", THEME.SUCCESS) end
                        FARM_ENABLED = true; toggleBtn.Text = "◉  AUTO FARM: ON"; setButtonState(toggleBtn, true)
                        CANDY_ENABLED = true; candyBtn.Text = "◉  AUTO CANDY: ON"; setButtonState(candyBtn, true)
                    end
                else
                    if _G.setStatus then _G.setStatus("Piñata: Waiting...", THEME.MUTED) end
                end
            end

            if not PINATA_ENABLED or not findPinata() then
                if CANDY_ENABLED then
                    local _, _, candyCount = findCandyTarget()
                    if candyCount > 0 then
                        if FARM_ENABLED then FARM_ENABLED = false; toggleBtn.Text = "◉  AUTO FARM: OFF"; setButtonState(toggleBtn, false) end
                        if _G.setStatus then _G.setStatus("Candy Detected!", CANDY_CHAMS_COLOR) end
                        collectAllCandy()
                        if CANDY_ENABLED and not FARM_ENABLED and not PINATA_ENABLED then
                            FARM_ENABLED = true; toggleBtn.Text = "◉  AUTO FARM: ON"; setButtonState(toggleBtn, true)
                        end
                    end
                end

                if INVISIBLE_ENABLED and not FARM_ENABLED and not PINATA_ENABLED then
                    local targetPart, targetPrompt, targetModel = findDoorTarget()
                    if targetPart and targetPrompt then
                        clearAllChams()
                        applyChams(targetPart, 1, THEME.INVIS)
                        applyChams(targetModel or targetPart.Parent, 2, THEME.INVIS)

                        local skyCF = targetPart.CFrame * CFrame.new(0, INVIS_HEIGHT, 0)
                        if _G.setStatus then _G.setStatus("Invisible: Tween to sky", THEME.INVIS) end
                        forceTweenTo(skyCF)
                        if not INVISIBLE_ENABLED then continue end

                        local doorCF = targetPart.CFrame * CFrame.new(0, 0, INTERACT_DISTANCE)
                        if _G.setStatus then _G.setStatus("Invisible: Knock (" .. INVIS_STAY .. "s)", THEME.INVIS) end
                        instantTeleportTo(doorCF)
                        task.wait(INVIS_STAY)

                        tryKnock(targetPrompt)
                        task.wait(WAIT_AT_DOOR)

                        if _G.setStatus then _G.setStatus("Invisible: Tween back to sky", THEME.INVIS) end
                        forceTweenTo(skyCF)
                        task.wait(COOLDOWN_DURATION)
                    else
                        if _G.setStatus then _G.setStatus("No doors found", THEME.MUTED) end
                        task.wait(0.5)
                    end
                end

                if FARM_ENABLED then
                    local currentTarget, currentPrompt, currentModel = findDoorTarget()
                    if currentTarget and currentPrompt then
                        clearAllChams()
                        applyChams(currentTarget, 1)
                        applyChams(currentModel or currentTarget.Parent, 2)
                        local doorGroundCFrame = currentTarget.CFrame * CFrame.new(0, 0, INTERACT_DISTANCE)
                        local doorSkyCFrame = doorGroundCFrame * CFrame.new(0, AIR_HEIGHT, 0)
                        if _G.setStatus then _G.setStatus("Door: " .. currentTarget.Name, THEME.SUCCESS) end
                        forceTweenTo(doorSkyCFrame)
                        forceTweenTo(doorGroundCFrame)
                        if _G.setStatus then _G.setStatus("Trick or Treat!", THEME.SUCCESS) end
                        tryKnock(currentPrompt)
                        task.wait(WAIT_AT_DOOR)
                        forceTweenTo(doorSkyCFrame)
                        task.wait(COOLDOWN_DURATION)
                    else
                        if not CANDY_ENABLED and not PINATA_ENABLED and not INVISIBLE_ENABLED then
                            if _G.setStatus then _G.setStatus("No doors found", THEME.MUTED) end
                        end
                        task.wait(0.5)
                    end
                elseif CANDY_ENABLED and not PINATA_ENABLED and not INVISIBLE_ENABLED then
                    if _G.setStatus then _G.setStatus("Waiting for candy...", THEME.MUTED) end
                    task.wait(0.5)
                end
            end
        end
        clearAllChams()
        stopSkillSpam()
        if _G.setStatus then _G.setStatus("Stopped", THEME.MUTED) end
    end)
end

local function stopFarm()
    FARM_ENABLED = false
    CANDY_ENABLED = false
    PINATA_ENABLED = false
    INVISIBLE_ENABLED = false
    clearAllChams()
    stopSkillSpam()
    if currentTween then currentTween:Cancel(); currentTween = nil end
    setNoclip(false)
    if farmThread then task.cancel(farmThread); farmThread = nil end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        pcall(function() humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    if _G.setStatus then _G.setStatus("Off", THEME.MUTED) end
end

